{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "vet",
        "pet_sitter",
        "groomer",
        "trainer",
        "boarding",
        "walker",
        "store"
      ]
    },
    "description": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "hours": {
      "type": "string"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepts_emergency": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "type",
    "city"
  ]
}
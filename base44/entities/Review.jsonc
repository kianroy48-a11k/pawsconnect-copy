{
  "name": "Review",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "description": "The service being reviewed"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "content": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "service_id",
    "rating",
    "content",
    "author_email"
  ]
}
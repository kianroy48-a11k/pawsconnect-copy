{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses of conversation participants"
    },
    "last_message": {
      "type": "string",
      "description": "Preview of the last message"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last message"
    },
    "unread_count": {
      "type": "object",
      "description": "Unread count per user"
    }
  },
  "required": [
    "participants"
  ]
}